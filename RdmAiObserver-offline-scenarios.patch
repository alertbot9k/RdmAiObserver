@@ -0,0 +1,49 @@
+using System;
+
+namespace SamplePlugin;
+
+public sealed record Recommendation(string Action, string Reason, RecommendationPriority Priority);
+
+public enum RecommendationPriority
+{
+    Low,
+    Medium,
+    High,
+    Critical
+}
+
+public static class RecommendationEngine
+{
+    public static Recommendation Evaluate(GameState state)
+    {
+        var player = state.Player;
+
+        if (!state.LoggedIn || player == null)
+            return new Recommendation("WAIT", "No player state is available.", RecommendationPriority.Low);
+
+        if (player.MaxHp == 0)
+            return new Recommendation("WAIT", "Maximum HP has not loaded yet.", RecommendationPriority.Low);
+
+        var hpPercent = 100f * player.Hp / player.MaxHp;
+
+        if (hpPercent <= 25f)
+            return new Recommendation("RECUPERATE / DISENGAGE", "HP is critically low.", RecommendationPriority.Critical);
+
+        if (hpPercent <= 45f)
+            return new Recommendation("RECUPERATE", "Restore HP before committing.", RecommendationPriority.High);
+
+        if (state.Target == null)
+            return new Recommendation("SELECT TARGET", "No target is selected.", RecommendationPriority.Medium);
+
+        if (state.Target.Distance > 25f)
+            return new Recommendation("CLOSE DISTANCE", "Target is outside practical attack range.", RecommendationPriority.Medium);
+
+        if (state.Target.Distance > 15f)
+            return new Recommendation("RANGED PRESSURE", "Target is at long range.", RecommendationPriority.Medium);
+
+        if (state.Target.Distance > 5f)
+            return new Recommendation("BUILD PRESSURE", "Target is in mid-range.", RecommendationPriority.Medium);
+
+        return new Recommendation("MELEE COMMIT CHECK", "Target is in melee range and HP is stable.", RecommendationPriority.High);
+    }
+}
diff --git a/SamplePlugin/ScenarioLibrary.cs b/SamplePlugin/ScenarioLibrary.cs
new file mode 100644
index 0000000..d0f76b6
--- /dev/null
+++ b/SamplePlugin/ScenarioLibrary.cs
@@ -0,0 +1,46 @@
+using System.Collections.Generic;
+
+namespace SamplePlugin;
+
+public sealed record ObserverScenario(string Name, string Description, GameState State);
+
+public static class ScenarioLibrary
+{
+    public static IReadOnlyList<ObserverScenario> All { get; } =
+    [
+        Create("Healthy, no target", "Validates target selection advice.", 100, null),
+        Create("Long range target", "Validates ranged positioning advice.", 100, 22f),
+        Create("Mid-range target", "Validates pressure-building advice.", 82, 10f),
+        Create("Melee opportunity", "Validates a possible melee commit.", 90, 3f),
+        Create("Low HP", "Validates healing priority.", 40, 8f),
+        Create("Critical HP", "Validates emergency survival priority.", 20, 3f)
+    ];
+
+    private static ObserverScenario Create(string name, string description, uint hpPercent, float? distance)
+    {
+        const uint maxHp = 10000;
+
+        return new ObserverScenario(name, description, new GameState
+        {
+            LoggedIn = true,
+            TerritoryId = 0,
+            Player = new PlayerSnapshot
+            {
+                Name = "Scenario RDM",
+                Job = "Red Mage",
+                Hp = maxHp * hpPercent / 100,
+                MaxHp = maxHp,
+                Mp = 10000,
+                MaxMp = 10000
+            },
+            Target = distance.HasValue
+                ? new TargetSnapshot
+                {
+                    Name = "Training Target",
+                    Kind = "PlayerCharacter",
+                    Distance = distance.Value
+                }
+                : null
+        });
+    }
+}
